// Cloudflare config for the Worker. Nitro merges this into the generated
// dist/server/wrangler.json at build time (main, assets and compatibility
// settings come from the build), and `npm run dev` reads it to emulate the
// bindings locally (state in .wrangler/state, which git ignores).
//
// Setting it up the first time: docs/applications-setup.md.
{
  "name": "forge2026",

  // The site answers only on its own domain (set under Domains & Routes in
  // the dashboard). The workers.dev address and per-version preview URLs
  // would reach the same Worker and data without the zone's Access, WAF and
  // rate limiting rules, so they stay off, and every deploy keeps them off.
  "workers_dev": false,
  "preview_urls": false,

  // Variables and secrets are managed in the dashboard; deploys must not wipe them.
  "keep_vars": true,

  // Builder applications (src/lib/apply/store.server.ts creates the tables).
  // Created in the dashboard with the EU jurisdiction. Keep the ID: without
  // one, Wrangler would quietly create a new database outside the EU.
  "d1_databases": [
    {
      "binding": "APPLICATIONS_DB",
      "database_name": "forge-applications",
      "database_id": "f13f13a4-c5b5-4697-b0cf-b4c501d7f4e2",
    },
  ],

  // Applicants' CVs. Private: no public access, no r2.dev URL. Only the
  // review API reads them. EU jurisdiction, so files stay in the EU.
  "r2_buckets": [
    {
      "binding": "APPLICATION_FILES",
      "bucket_name": "forge-applications",
      "jurisdiction": "eu",
    },
  ],

  // Per Cloudflare location, shared by every isolate (the in-memory limits in
  // src/lib/security.ts stay underneath as a floor).
  "ratelimits": [
    {
      // Applications per client address. Turnstile stops scripts; this stops floods.
      "name": "APPLY_LIMITER",
      "namespace_id": "20261001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      // Review API calls per signed-in reviewer.
      "name": "REVIEW_LIMITER",
      "namespace_id": "20261002",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
}
