# Header rules for static assets (Workers static assets read this file).
#
# The Worker in src/server.ts attaches the full policy to everything it
# serves. This file is the backstop for responses the asset layer serves
# without invoking the Worker, so a request for an image or a font is never the
# one response that arrives with no policy on it. Assets never need inline
# scripts, so this policy allows none.
#
# Keep this in step with src/lib/security.ts. That file is the source of truth;
# this is a copy that exists because it has to live outside the bundle.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Origin-Agent-Cluster: ?1

# Fonts and brand artwork are fingerprinted or stable, and are the assets most
# worth keeping out of the render path on a phone.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800
